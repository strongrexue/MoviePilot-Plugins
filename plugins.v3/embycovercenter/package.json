{
    "name":  "moviepilot-embycovercenter-plugin",
    "private":  true,
    "version":  "1.6.14",
    "type":  "module",
    "scripts":  {
                    "clean":  "node -e \"const fs=require(\u0027fs\u0027);const dir=\u0027dist/assets\u0027;if(fs.existsSync(dir)){for(const f of fs.readdirSync(dir)){if(f!==\u0027.gitkeep\u0027)fs.unlinkSync(dir+\u0027/\u0027+f);}}\"",
                    "dev":  "vite build --watch",
                    "build":  "npm run clean \u0026\u0026 vite build"
                },
    "dependencies":  {
                         "vue":  "^3.5.13",
                         "vuetify":  "3.7.3"
                     },
    "devDependencies":  {
                            "@originjs/vite-plugin-federation":  "^1.4.1",
                            "@vitejs/plugin-vue":  "^5.0.4",
                            "vite":  "^5.4.11"
                        }
}
